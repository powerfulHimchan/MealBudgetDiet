# Sikbi production identity
PUBLIC_BASE_URL=https://sikbi.app
PROBLEM_BASE_URL=https://sikbi.app/problems
SESSION_COOKIE_SECURE=true

# Railway PostgreSQL
# Configure these as Railway reference variables in the sikbi-api service.
DB_URL=jdbc:postgresql://<private-postgres-host>:5432/<database>
DB_USERNAME=<database-user>
DB_PASSWORD=<secret>
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# Bootstrap and authentication
BOOTSTRAP_TOKEN=<long-random-secret>
AUTH_RATE_LIMIT_SECRET=<at-least-32-random-characters>
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW=15m
AUTH_PASSWORD_RESET_EMAIL_MAX_REQUESTS=3
AUTH_PASSWORD_RESET_CLIENT_MAX_REQUESTS=10
AUTH_PASSWORD_RESET_WINDOW=1h
AUTH_RATE_LIMIT_RETENTION=7d
STRUCTURED_LOG_FORMAT=ecs

# Password reset email
PASSWORD_RESET_TOKEN_TTL=30m
PASSWORD_RESET_EMAIL_ENABLED=false
PASSWORD_RESET_EMAIL_FROM=no-reply@sikbi.app
SPRING_MAIL_HOST=<smtp-host>
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<smtp-user>
SPRING_MAIL_PASSWORD=<secret>
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Web Push
VAPID_PUBLIC_KEY=<public-key>
VAPID_PRIVATE_KEY=<secret>
VAPID_SUBJECT=mailto:<privacy-contact-email>
PUSH_DISPATCH_ENABLED=true

# Private S3-compatible object storage
MEDIA_BUCKET=sikbi
MEDIA_ENDPOINT=https://<s3-compatible-endpoint>
MEDIA_REGION=ap-northeast-2
MEDIA_ACCESS_KEY=<access-key>
MEDIA_SECRET_KEY=<secret>

# sikbi-web service
BACKEND_INTERNAL_URL=http://<sikbi-api-private-domain>:8080
